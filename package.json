{
  "name": "pupgram",
  "version": "0.3.3",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node ./src/index.ts",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "playground": "ts-node ./playground/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint --fix \"{src,tests}/**/*.ts\"",
    "ci": "npm run lint:fix && npm run format && npm run test:coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "instagram",
    "puppeteer",
    "pupgram",
    "instagram-bot",
    "instagram-automation"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@marcuth/env": "^0.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-sort-imports": "^1.8.11",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.19.0"
  }
}
